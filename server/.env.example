# Copy this file to .env (same folder) and fill it in. Never share or upload .env.
# Discord application Client ID (Developer Portal -> OAuth2).
DISCORD_CLIENT_ID=1573861693820502149
# Bot token (Developer Portal -> Bot -> Reset Token). Used by the Discord bot (discord-bot.js) and to
# DM each website tip's code. The bot can only message people who share a Discord server with it.
# Leave empty to keep the bot and website tips off.
DISCORD_BOT_TOKEN=
# Optional, for the Discord bot. Your server's ID makes new commands show up there at once
# (right-click the server -> Copy Server ID, with Developer Mode on). Empty registers them everywhere.
DISCORD_GUILD_ID=
# Optional: the website's address, shown by the bot's help.
SITE_URL=
# The character typed commands start with ($coinflip 50 heads). They need "Message Content Intent"
# switched on for the bot in the Developer Portal. Set it to nothing to use slash commands only.
BOT_PREFIX=$
# Anthropic API key from https://platform.claude.com . Leave empty to keep AI replies off.
ANTHROPIC_API_KEY=
# Which Claude model writes the replies. claude-opus-5-5 is the default; claude-haiku-5-5 is far cheaper.
CHAT_AI_MODEL=claude-opus-5-5
# Most AI requests allowed per minute.
CHAT_AI_PER_MINUTE=20
# Optional, for hosting. DATA_DIR is the folder the bot keeps bot-data.json in (a persistent disk on a
# host that wipes its storage on restart). BOT_LOCK=off skips the one-copy lock on such a host.
DATA_DIR=
BOT_LOCK=
